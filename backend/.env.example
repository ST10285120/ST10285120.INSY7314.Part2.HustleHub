PORT=5443
NODE_ENV=development

# MongoDB connection string. For local development, install MongoDB
# Community Server and leave this pointing at your local instance:
#   mongodb://127.0.0.1:27017/hustlehub
# For MongoDB Atlas, paste your connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub

SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=https://localhost:3000

# Only set when the API is behind your own reverse proxy AND not reachable
# directly (docker-compose sets this to 1). Leave unset for local development.
# TRUST_PROXY=1

# --- Admin bootstrap -------------------------------------------------------
# Admins cannot self-register. If both are set, an admin account is created on
# startup (only if that email doesn't exist yet). Min 12 chars, upper, lower,
# number and symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Rate limits and lockout (defaults shown) --------------------------------
# API_RATE_LIMIT_MAX=500        # requests per IP per 15 min, all /api routes
# LOGIN_RATE_LIMIT_MAX=10       # FAILED logins per IP per 15 min
# REGISTER_RATE_LIMIT_MAX=20    # registrations per IP per hour
# BOOKING_RATE_LIMIT_MAX=30     # bookings per IP per 15 min
# LOCKOUT_MAX_ATTEMPTS=5        # failed logins before an account is locked
# LOCKOUT_MINUTES=15            # how long the lock lasts

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=info
# LOG_TO_FILE=true              # also write logs/combined.log and logs/error.log
# Cloud logging (Better Stack Telemetry). Create an "HTTP" source and copy its
# source token and ingesting host. Leave empty to disable.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
