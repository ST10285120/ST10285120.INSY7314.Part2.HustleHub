{
  "name": "hustlehub-backend",
  "version": "3.0.0",
  "description": "HustleHub+ secure freelance marketplace API (Part 3: DevSecOps, monitoring and finalisation)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:ci": "jest --runInBand --ci --coverage --json --outputFile=reports/jest-results.json",
    "cert": "bash scripts/generate-cert.sh",
    "seed": "node scripts/seed.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "winston": "^3.13.1",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "reports/coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/__tests__/**"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/setupEnv.js"
    ]
  }
}
