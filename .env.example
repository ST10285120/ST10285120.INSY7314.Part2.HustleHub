# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.
#
# Generate strong values with:
#   openssl rand -hex 32
# (use hex/alphanumeric for the Mongo password - it goes into a connection URL)

MONGO_ROOT_USERNAME=hustlehub
MONGO_ROOT_PASSWORD=change_me_to_a_random_hex_string

JWT_SECRET=change_me_to_at_least_32_random_characters
JWT_EXPIRES_IN=1h

# First admin account, created on startup if it doesn't exist yet.
# Password: min 12 chars with upper, lower, number and symbol.
ADMIN_EMAIL=admin@hustlehub.test
ADMIN_PASSWORD=

# Optional cloud logging (Better Stack Telemetry -> Sources -> HTTP).
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
